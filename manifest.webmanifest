{
  "name": "Pulse — Offline Music & Gym Player",
  "short_name": "Pulse",
  "description": "Your own offline music library and workout player. Import your files, tag them, and train.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0b0c10",
  "theme_color": "#0b0c10",
  "categories": [
    "music",
    "fitness",
    "entertainment"
  ],
  "icons": [
    {
      "src": "./icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "media",
          "accept": [
            "audio/*",
            "video/*",
            ".mp3",
            ".m4a",
            ".flac",
            ".ogg",
            ".opus",
            ".wav",
            ".mp4",
            ".mov",
            ".webm",
            ".mkv"
          ]
        }
      ]
    }
  },
  "shortcuts": [
    {
      "name": "Gym Mode",
      "short_name": "Gym",
      "url": "./index.html?view=gym"
    },
    {
      "name": "Favorites",
      "short_name": "Favs",
      "url": "./index.html?view=favorites"
    }
  ]
}